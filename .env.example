# CairnShop 测试环境配置（复制为 .env 后按需修改）

CAIRNSHOP_TEST_BASE_URL=http://127.0.0.1:8080
CAIRNSHOP_TEST_UI_URL=http://127.0.0.1:5173

# 与 CairnShop seed 出来的管理员一致
CAIRNSHOP_TEST_ADMIN_EMAIL=admin@cairnshop.local
CAIRNSHOP_TEST_ADMIN_PASSWORD=admin123456

CAIRNSHOP_TEST_TIMEOUT=5
# 0 = 没有 CairnKV 时跳过 requires_cairnkv 用例（订单/配置相关）
CAIRNSHOP_TEST_REQUIRE_CAIRNKV=1
